@spritesheet demo-sheet
{
	src: /assets/ui_elements.tga;

	window-outer: 0px 0px 144px 151px;

	demo-radio-t: 407px  0px 30px 14px;
	demo-radio-c: 407px 14px 30px  2px;
	demo-radio-b: 407px 16px 30px 14px;

	demo-radio-l: 407px 0px 14px 30px;
	demo-radio-m: 421px 0px  2px 30px;
	demo-radio-r: 423px 0px 14px 30px;

	demo-checkbox-t: 407px 60px 30px 14px;
	demo-checkbox-c: 407px 74px 30px  2px;
	demo-checkbox-b: 407px 76px 30px 14px;

	demo-checkbox-l: 407px 60px 14px 30px;
	demo-checkbox-m: 421px 60px  2px 30px;
	demo-checkbox-r: 423px 60px 14px 30px;

	demo-checked-t: 407px  90px 30px  8px;
	demo-checked-c: 407px  98px 30px 14px;
	demo-checked-b: 407px 112px 30px  8px;

	demo-help-t:    128px 152px 51px  6px;
	demo-help-c:    128px 158px 51px 21px;
	demo-help-b:    128px 179px 51px 12px;

	demo-title-bar: 147px 0px 96px 85px;
}

body.window
{
	inset: 50dp 50dp;
	/*
	min-width: 1040dp;
	min-height: 300dp;
	max-width: none;
	max-height: none;
	*/
}
div#title_bar div#icon
{
	display: none;
}
div#content
{
	position: relative;
	color: #393131;
}
tabset
{
	display: block;
}
tabs
{
	display: block;
	position: fixed;
	text-align: right;
	clip: none;
	top: -47dp;
	left: 0dp;
	right: 10dp;
}
tab
{
	width: 120dp;
	padding: 0 10dp;
	line-height: 40dp;
	display: inline-block;
	clip:none;

	font-size: 12dp;
	color: #ddd;
	text-align: center;

	decorator: tiled-horizontal( tableheader-l, tableheader-c, tableheader-r );
	image-color: #cffc;
}
tab:hover
{
	image-color: #fffe;
	color: #fff;
}
tab:active, tab:selected
{
	image-color: #fff;
	color: #fff;
}
panels
{
	display: block;
}
panel
{
	display: block;
	padding: 30dp;
	margin-left: auto;
	margin-right: auto;
	/* max-width: 500dp; */
}
h1
{
	margin: 1.4em 0 0.7em;
	font-size: 18dp;
}
p.title
{
	font-size: 35dp;
	color: #b33;
	font-effect: glow(2dp #ed5);
	text-align: center;
}
.center {
	text-align: center;
}
.clickable
{
	cursor: pointer;
}

.schedule-grid {
	border: 1dp #777;
	background-color: #111;
	padding: 4dp;
	margin-top: 14dp;
}

.schedule-toolbar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 10dp;
}

.schedule-summary {
	font-size: 14dp;
	font-weight: bold;
	color: #fff;
	margin-bottom: 0;
	padding: 6dp 8dp;
	background-color: #1e1e1e;
	opacity: 0.95;
	border: 1dp #555;
	border-radius: 4dp;
	/* min-width: 100dp; */
	text-align: center;
}

.schedule-summary.invalid {
	background-color: #8b0000;
	border: 1dp #b33;
}
.schedule-grid .schedule-row {
	display: flex;
}
.schedule-grid .schedule-row .slot,
.schedule-grid .schedule-header .slot {
	width: 80dp;
	height: 28dp;
	line-height: 28dp;
	border: 1dp #aaa;
	text-align: center;
	font-size: 10dp;
	cursor: pointer;
	margin: 0;
	padding: 2dp;
	background-color: #171717;
}
.schedule-grid .schedule-header .slot { background: #222; font-weight: bold; color: #fff; }
.schedule-grid .schedule-row .slot.day-label { width: 56dp; background: #1a1a1a; cursor: default; color: #fff; }
.schedule-grid .schedule-row .slot.selected { background: #3399ff; color: #fff; }
.schedule-grid .schedule-row .slot.other { background: #bb8; color: #111; }
.schedule-grid .schedule-row .slot:hover { /* no style; support only click/drag selection */ }
.schedule-grid .schedule-row .slot.schedule-dragging { background-color: rgba(75, 178, 255, 0.45); }

/***  Decorators  ***/
#decorators {
	text-align: left;
}
#decorators p
{
	margin: 0.5em 0;
}
#decorators button.gradient
{
	decorator: vertical-gradient( #377571 #5990A3 );
	border: 3dp #415857;
	border-radius: 8dp;
	margin-right: 12dp;
}
#decorators button.gradient.horizontal
{
	decorator: horizontal-gradient( #cebdbd #bea99a );
	border-color: #9f9f9f;
}
#decorators button.gradient:hover
{
	border-color: #524f3a;
}
.side-by-side
{
	display: inline-block;
	width: 120dp;
	vertical-align: middle;
	text-align: center;
}
.tiled-box
{
	height: 200dp;
	decorator: tiled-box(
		window-tl, window-t, window-tr,
		window-l, window-c, window-r,
		window-bl, window-b, window-br
	);
}
.image-mode
{
	text-align: center;
	margin-top: 30dp;
}
.image-mode > div
{
	display: inline-block;
	width: 120dp;
	height: 50dp;
	padding: 5dp 10dp;
	margin: 10dp 10dp;
	background-color: #c662;
	border: 1dp #777;
	font-effect: shadow( 1dp 1dp #333 );
}
.image-mode.repeat > div {
	height: 120dp;
}
#decorators .image-mode > div > p
{
	margin: -2em 0 0 0;
	text-align: center;
}
.image-mode.small { margin-top: -15dp; }
.image-mode.small > div
{
	width: 40dp;
	height: 20dp;
	padding: 0;
	margin-left: 60dp;
	margin-right: 60dp;
}
.align-default     { decorator: image( icon-invader scale-none             ); }
.align-right       { decorator: image( icon-invader scale-none right       ); }
.align-left-bottom { decorator: image( icon-invader scale-none left bottom ); }
.align-percent     { decorator: image( icon-invader scale-none 70% 30%     ); }
.align-pixel       { decorator: image( icon-invader scale-none 100px -15px ); }
.fit-fill       { decorator: image( icon-invader fill       ); }
.fit-contain    { decorator: image( icon-invader contain    ); }
.fit-cover      { decorator: image( icon-invader cover      ); }
.fit-scale-none { decorator: image( icon-invader scale-none ); }
.fit-scale-down { decorator: image( icon-invader scale-down ); }
.fit-repeat   { decorator: image( /assets/alien_small.tga repeat ); }
.fit-repeat-x { decorator: image( /assets/alien_small.tga repeat-x ); }
.fit-repeat-y { decorator: image( /assets/alien_small.tga repeat-y ); }
.orientation-vertical   { decorator: image( icon-invader flip-vertical   scale-none ); }
.orientation-horizontal { decorator: image( icon-invader flip-horizontal scale-none ); }
.orientation-rotate     { decorator: image( icon-invader rotate-180      scale-none ); }


/***  Font effects  ***/

#font_effects div
{
	display: inline-block;
	width: 180dp;
	margin: 0 30dp 30dp;
	text-align: center;
	font-size: 35dp;
	color: rgb(0, 0, 0);
}
#font_effects h1
{
	margin: 15dp 0 10dp 0;
}
#font_effects .glow
{
	font-effect: glow(3dp #ed5);
}
#font_effects .glow_sharper
{
	font-effect: glow(3dp 1dp #ed5);
}
#font_effects .glow_blurry
{
	font-effect: glow(2dp 7dp #ed5);
}
#font_effects .glow_shadow
{
	color: #ed5;
	font-effect: glow(2dp 4dp 2dp 3dp #644);
}
#font_effects .outline_small
{
	font-effect: outline(2dp #ed5);
}
#font_effects .outline_big
{
	font-effect: outline(4dp #ed5);
}
#font_effects .blur_small
{
	color: #fff2;
	font-effect: blur(3dp #ed5);
}
#font_effects .blur_big
{
	color: #fff1;
	font-effect: blur(10dp #ed5);
}
#font_effects .shadow_up
{
	font-weight: bold;
	font-effect: shadow(3dp -3dp #ed5);
}
#font_effects .shadow_down
{
	font-weight: bold;
	font-effect: shadow(0px 2dp #333);
}




/***  Forms  ***/

form {
	display: block;
	text-align: left;
}
form input, form select {
	margin-left: 0;
	vertical-align: middle;
}
input.text, input.password {
	width: 35%;
}
input.text.two-wide {
	width: 70%;
}
form h2 {
	display: block;
	font-size: 16dp;
	font-weight: bold;
	margin-top: 0.6em;
	margin-bottom: 0.4em;
}
#controls textarea selection
{
	background-color: #aca;
	color: #999;
}
#controls textarea::placeholder
{
	font-effect: outline(2dp #aba);
	color: #fafafa;
}


/***  Sandbox  ***/

#sandbox
{
	position: absolute;
	top: 20dp;
	right: 30dp;
	bottom: 20dp;
	left: 30dp;
	padding: 0;
	max-width: none;
}
#sandbox table
{
	height: 100%;
	gap: 5dp;
}
#sandbox tr
{
	background-color: transparent;
}
#sandbox textarea
{
	font-size: 13dp;
	color: #222;
	font-family: rmlui-debugger-font;
	box-sizing: border-box;
	width: 100%;
	height: 100%;
}
#sandbox_target
{
	box-sizing: border-box;
	background-color: #fff;
	border: 1px #000;
	height: 100%;
	color: #000;
	text-align: left;
	position: relative;
}
#col_rml_source
{
	/* min-width: 15%;
	max-width: 85%; */
}
#row_source
{
	height: 40%;
	/* min-height: 15%;
	max-height: 85%; */
}
.slider
{
	display: block;
	height: 100%;
	background: #3332;
	cursor: move;
	box-sizing: border-box;
	border: 4dp transparent;
}
.slider:hover, .slider:active
{
	background: #dda;
}
#vertical_slider
{
	width: 12dp;
	margin-left: 3dp;
	padding-top: 5dp;
}
#horizontal_slider
{
	height: 12dp;
}
form input, form textarea, form select
{
	nav: vertical;
}
form .nav-auto, form input.checkbox, form input.radio
{
	nav: auto;
}

td.filter_checkbox {
	width: 30px;
}

.flex {
	display: flex;
}
.flex > div {
	flex: 1;
}

table {
	box-sizing: border-box;
	display: table;
}
tr {
	box-sizing: border-box;
	display: table-row;
}
td {
	box-sizing: border-box;
	display: table-cell;
}
col {
	box-sizing: border-box;
	display: table-column;
}
colgroup {
	display: table-column-group;
}
thead, tbody, tfoot {
	display: table-row-group;
}