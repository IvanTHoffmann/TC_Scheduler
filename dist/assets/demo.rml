<rml>
<head>
<link type="text/template" href="window.rml"/>
<link type="text/template" href="tutor_select.rml"/>
<link type="text/template" href="department_select.rml"/>
<link type="text/template" href="service_select.rml"/>
<link type="text/template" href="timetable.rml"/>
<title>Tutoring Center Scheduler</title>
<link type="text/rcss" href="style.rcss"/>
</head>

<body template="window">

<tabset data-model="app_data">

<tab data-event-click="OnClick_SummaryTab()">Overview</tab>
<panel>

Hello Sam! You've downloaded the latest version.
	
	<div>
		<button class="gradient" data-event-click="OnTutorChanged(-1)">Apply Filter</button>
		<template src="timetable"/>

		<br/>

		<div class="flex">
			<div>
				<table class="filter_table">
					<thead>
						<tr>
							<td colspan="2">SERVICES</td>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="filter_checkbox">
								<button class="gradient" style="width:85%" data-event-click="SetSelectedServices(true)">All</button>
							</td>
							<td class="filter_checkbox">
								<button class="gradient" style="width:85%" data-event-click="SetSelectedServices(false)">None</button>
							</td>
						</tr>
						<tr data-for="service:services"
							data-event-mousedown="service.selected = !service.selected" 
							data-style-background="service.selected ? 'rgb(120, 255, 120)' : '#ffffff'">
							<td colspan="2">
								{{service.description}}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div>
				<table class="filter_table">
					<thead>
						<tr>
							<td colspan="2">DEPARTMENTS</td>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="filter_checkbox">
								<button class="gradient" style="width:85%" data-event-click="SetSelectedDepartments(true)">All</button>
							</td>
							<td class="filter_checkbox">
								<button class="gradient" style="width:85%" data-event-click="SetSelectedDepartments(false)">None</button>
							</td>
						</tr>
						<tr data-for="dept:departments"
							data-event-mousedown="dept.selected = !dept.selected" 
							data-style-background="dept.selected ? 'rgb(120, 255, 120)' : '#ffffff'">
							<td colspan="2">
								{{dept.name}}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div>
				<table class="filter_table">
					<thead>
						<tr>
							<td colspan="2">TUTORS</td>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="filter_checkbox">
								<button class="gradient" style="width:85%" data-event-click="SetSelectedTutors(true)">All</button>
							</td>
							<td class="filter_checkbox">
								<button class="gradient" style="width:85%" data-event-click="SetSelectedTutors(false)">None</button>
							</td>
						</tr>
						<tr data-for="tutor:tutors" 
							data-event-mousedown="tutor.selected = !tutor.selected" 
							data-style-background="tutor.selected ? 'rgb(120, 255, 120)' : '#ffffff'">
							<td colspan="2">
								{{tutor.first_name}} {{tutor.last_name}}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<br/>
		First name:
		<input type="text" data-value="mod_tutor_first_name" style="width:20%"/>
		Last name:
		<input type="text" data-value="mod_tutor_last_name" style="width:20%"/>
		<button class="gradient" data-event-click="AddTutor">Add Tutor</button>
		<button class="gradient" data-event-click="RemoveTutor">Remove Tutor</button>

		<br/>
		Service Name: 
		<input type="text" data-value="mod_service_name" style="width:20%"/>
		<button class="gradient" data-event-click="AddService">Add Service</button>
		<button class="gradient" data-event-click="RemoveService">Remove Service</button>

		<br/>
		Department Name: 
		<input type="text" data-value="mod_department_name" style="width:20%"/>
		<button class="gradient" data-event-click="AddDepartment">Add Department</button>
		<button class="gradient" data-event-click="RemoveDepartment">Remove Department</button>

	</div>
</panel>

<tab data-event-click="OnClick_SchedulesTab()">Manage Schedules</tab>
<panel>

	<div data-if="!edit_tutor">
		<template src="tutor_select"/>
		<br/>
		<button data-for="selected_tutor.accessor" class="gradient" data-event-click="EnableEditTutor">Edit Tutor</button>
	</div>

	<div data-if="edit_tutor" data-for="tutor:selected_tutor.accessor">
		<span>First Name:</span>
		<input type="text" data-value="tutor.first_name" style="width:20%;"/>
		<span>Last Name:</span>
		<input type="text" data-value="tutor.last_name" style="width:20%;"/>
		<span>Email:</span>
		<input type="text" data-value="tutor.email" style="width:20%;"/>

		<br/>

		<button class="gradient" data-event-click="ConfirmEditTutor">Confirm</button>
	</div>

	<div data-for="selected_tutor.accessor">
		<div class="schedule-toolbar">
			<button class="gradient" data-event-click="ResetGrid">Reset Grid</button>
			<template src="service_select"/>
			<button class="gradient" data-event-click="SaveSchedule">Save</button>
			<div class="schedule-summary" data-style-background-color="schedule_valid ? '#4CAF50' : '#f44336'">Total: {{formatted_total_hours}}</div>
		</div>
		<template src="timetable" />

		<div data-for="tutor:selected_tutor.accessor">
			<div>
				<span>Min hours: {{tutor.min_hours}}</span>
				<input type="range" data-value="tutor.min_hours" min=0 max=60 step=1 data-event-change="ScheduleLimitsChanged" data-event-input="ScheduleLimitsChanged"/>
			</div>
			<div>
				<span>Max hours: {{tutor.max_hours}}</span>
				<input type="range" data-value="tutor.max_hours" min=0 max=60 step=1 data-event-change="ScheduleLimitsChanged" data-event-input="ScheduleLimitsChanged"/>
			</div>
		</div>
	</div>

	<br/>

	<div data-if="!edit_tutor">
		<table data-for="tutor:selected_tutor.accessor">
			<thead>
				<tr>
					<td>Department</td>
					<td>Courses</td>
				</tr>
			</thead>
			<tbody>
				<tr data-for="classList:tutor.classes">
					<td>{{classList.department_name}}</td>
					<td>
						<span data-if="classList.subtractive">All{{classList.courses.size ? ' Except ' : ''}}</span>
						<span data-for="course:classList.courses">{{it_index ? ', ' : ''}}{{course}}</span>
					</td>
				</tr>
			</tbody>
		</table>
	</div>

	<div data-if="edit_tutor" data-for="tutor:selected_tutor.accessor">
		<table>
			<thead>
				<tr>
					<td style="width:auto">Department</td>
					<td style="width:auto">All / All Except</td>
					<td>Courses</td>
					<td>Output</td>
				</tr>
			</thead>
			<tbody>
				<tr data-for="department:departments">
					<td style="width:auto">{{department.name}}</td>
					<td>
						<input type="checkbox" data-checked="department.edit_subtractive"/>
					</td>
					<td>
						<input data-value="department.edit_formatted_courses"></input>
					</td>
					<td>
						<span data-if="department.edit_subtractive">All{{department.edit_courses.size ? ' Except ' : ''}}</span>
						<span data-for="course:department.edit_courses">{{it_index ? ', ' : ''}}{{course}}</span>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</panel>

<tab data-event-click="OnClick_RolodexTab">Rolodex</tab>
<panel>
	<div>
		<button class="gradient" data-event-click="AddRolodexHeader()">Add Rolodex Card</button>

		<table>
			<thead>
				<tr>
					<td>Description</td>
					<td>Courses</td>
					<td style="width:auto"></td>
				</tr>
			</thead>

			<tbody>
				<tr data-for="rolodex_card : rolodex_headers">
					<td>
						<input data-value="rolodex_card.description"/>
					</td>
					<td>
						<span data-for="classList: rolodex_card.classes">
							<span>{{classList.department_name}}</span>
							<span>
								&nbsp;(
								<span data-if="classList.subtractive">All{{classList.courses.size ? ' Except ' : ''}}</span>
								<span data-for="course:classList.courses">{{it_index ? ', ' : ''}}{{course}}</span>
								)&nbsp;&nbsp;&nbsp;
							</span>
						</span>
					</td>
					<td style="width:auto">
						<button class="gradient" data-event-click="SaveRolodexTarget()" data-if="rolodexTarget == it_index">Save</button>
						<button class="gradient" data-event-click="SetRolodexTarget(it_index)">Edit</button>
						<button class="gradient" data-event-click="DeleteRolodexTarget(it_index)">Delete</button>
					</td>
				</tr>
			</tbody>
		</table>
		
		<div data-if="rolodexTarget != -1">
			<table>
				<thead>
					<tr>
						<td style="width:auto">Department</td>
						<td style="width:auto">Selected</td>
						<td style="width:auto">All / All Except</td>
						<td>Courses</td>
						<td>Output</td>
					</tr>
				</thead>
				<tbody>
					<tr data-for="department:departments">
						<td style="width:auto">{{department.name}}</td>
						<td style="width:auto">
							<input type="checkbox" data-checked="department.edit_selected"/>
						</td>
						<td style="width:auto">
							<input type="checkbox" data-disabled="!department.edit_selected" data-checked="department.edit_subtractive"/>
						</td>
						<td>
							<input data-disabled="!department.edit_selected" data-value="department.edit_formatted_courses"></input>
						</td>
						<td>
							<span data-if="department.edit_subtractive">All{{department.edit_courses.size ? ' Except ' : ''}}</span>
							<span data-for="course:department.edit_courses">{{it_index ? ', ' : ''}}{{course}}</span>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</panel>

<tab data-event-click="">Export</tab>
<panel>
	<div>
		<button class="gradient" data-event-click="ExportAll">Export All</button>
	</div>
</panel>

<tab data-event-click="">Preferences</tab>
<panel>
	<div>
		This is the configuration page where you will be able to control the settings of the application.
	</div>
	<div>Export Directory:<input type="text" data-value="export_directory"/></div>
	<div>Developer Options:<input type="checkbox" data-value="dev_enable"/></div>
</panel>

<tab data-if="dev_enable" data-event-click="">Tests</tab>
<panel>
	
</panel>

</tabset>
</body>
</rml>
