/* Override the template's default padding */
#window, #content, #menu, panels, panel {
    display: block
    width: 100%
    max-width: none
    min-width: 100%
    margin: 0
    padding: 0
    left: 0
    top: 0
}

/* Core Layout & Typography */
body {
    font-family: Lato;
    font-weight: normal;
    font-style: normal;
    font-size: 15px;
    color: white;
}

div { display: block; }

#page_manage_schedules {
    padding: 10px;       /* Reduced padding to move closer to edges */
    width: 100% !important;
    height: 100% !important;
    display: block;
}

.title {
    font-size: 24px;
    margin-bottom: 20px;
    font-weight: bold;
}

/* Toolbar & Controls */
.toolbar {
    display: flex;       /* This aligns children horizontally */
    flex-direction: row;
    flex-wrap: nowrap;   /* Keeps everything on one line */
    align-items: center; /* Centers items vertically in the row */
    gap: 15px;           /* Space between buttons/dropdowns */
    padding: 10px;
    background-color: #2a2a2a;
    margin-bottom: 20px;
    width: 100%;         /* Ensures the bar stretches across */
}

/* Ensure labels don't take up too much room */
.toolbar label {
    margin-right: 5px;
    white-space: nowrap;
}

select {
    width: 200px;
    height: 35px;
    background-color: #444;
    border: 1px solid #666;
    margin-right: 10px;
    color: white;
}

button.gradient {
    display: inline-block;
    padding: 8px 15px;
    background: #007acc;
    border-radius: 3px;
    color: white;
}

/* THE TABLE ENGINE (RmlUi Specifics) */
/* This is the box that holds the scrollable table */
.schedule-container {
    display: block;
    width: 98%;
    height: 80%;
    margin: 0;             /* Remove any centering margins */
    padding: 0;            /* Remove internal gaps */
    overflow: auto;      /* Keeps scrollbars for the 96 segments */
    border: 1px solid #444;
}

.schedule-table {
    display: table;
    width: 100%;         /* Forces the table to fill the container */
    table-layout: fixed; 
    border-collapse: collapse;
}

/* Structural display rules */
table {
    /* This merges the borders of adjacent cells into a single line */
    border-collapse: collapse; 
    display: table;
}

thead, tbody { display: table-row-group; }
tr { display: table-row; }
td, th { 
    display: table-cell; 
    border: 1px solid rgb(144, 144, 164);
    text-align: center;
    vertical-align: middle;
}
colgroup { display: table-column-group; }
col { display: table-column; }

/* Cell Visuals */
.day-label {
    background-color: #e3e3e3;
    font-weight: bold;
    width: 100px; /* Defined width for the labels */
}

.slot {
    height: 45px;
    background-color: #e2dada11;
    min-width: 70px; /* Ensures cells don't shrink to 0 */
}

/* Tutoring Type Colors */
.math    { background-color: #3182ce; }
.computer_science  { background-color: #805ad5; }
.biology { background-color: #38a169; }
.chemistry { background-color: rgb(188, 109, 161); }