<rml>
<head>
<link type="text/template" href="window.rml"/>
<link type="text/template" href="tutor_select.rml"/>
<link type="text/template" href="timetable.rml"/>
<title>Tutoring Center Scheduler</title>
<link type="text/rcss" href="style.rcss"/>
</head>

<body template="window">

<tabset id="menu" data-model="app_data">

<tab>Summary</tab>
<panel id="summary">
	<p class="title" align:"center">Summary Page</p>
	
	<div data-model="app_data">
		<select name="service_name" onkeydown="cancel_selection_on_escape">
			<option value="none" selected>Choose Service</option>
			<option data-for="service:services">{{service.name}}</option>
		</select>
		<button class="gradient">Button</button>

		<template src="timetable"/>

	</div>

</panel>

<tab>Manage Schedules</tab>
<panel id="page_manage_schedules">
	<p class="title">Manage Schedules</p>
	<div data-model="app_data">
		<template src="tutor_select"/>

		<div data-for="tutor:selected_tutor.accessor">
			<div>
				<span>Min hours: {{tutor.min_hours}}</span>
				<input type="range" data-value="tutor.min_hours" min=0 max=60 step=1/>
			</div>
			<div>
				<span>Max hours: {{tutor.max_hours}}</span>
				<input type="range" data-value="tutor.max_hours" min=0 max=60 step=1/>
			</div>
		</div>
	</div>
</panel>

<tab>Manage Classes</tab>
<panel id="page_manage_classes">
	<p class="title">Manage Classes</p>
	<div data-model="app_data">
		<template src="tutor_select"/>
		<div data-for="tutor:selected_tutor.accessor">
			<div>
				<select name="department_name" data-value="selected_department" onkeydown="cancel_selection_on_escape">
					<option data-for="department:departments" data-value="it_index">{{department}}</option>
				</select>
				<input type="text" placeholder="All" data-value="courses_entry"/>
				<button class="gradient" data-event-click="AddCourses">Add</button>
				<button class="gradient" data-event-click="RemoveCourses">Remove</button>
			</div>
			<table>
				<thead>
					<tr>
						<td>Department</td>
						<td>Courses</td>
					</tr>
				</thead>
				<tbody>
					<tr data-for="class:tutor.classes">
						<td>{{departments[class.department_id]}}</td>
						<td>
						<span data-if="class.subtractive">All{{class.courses.size ? ' Except ' : ''}}</span>
						<span data-for="course:class.courses">{{it_index ? ', ' : ''}}{{course}}</span>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div> <!-- End of tutor info container -->
</panel>

<tab>Configure</tab>
<panel>
	<div>
		This is the configuration page where you will be able to control the settings of the application.
	</div>
</panel>

<tab>Test</tab>
<panel>
	<template src="tutor_select"/>

	<!--input type="text" data-value="test_int_vector_editable.scalar"></input-->

	<table>
		<thead>
			<tr>
				<td>Department</td>
				<td>All Except?</td>
				<td>Courses</td>
			</tr>
		</thead>
		<tbody>
			<tr data-for="department:departments">
				<td>{{department}}</td>
				<td><input type="checkbox"/></td>
				<td>
					<input type="text" data-value="test_int_vector_editable.scalar"></input>
				</td>
			</tr>
		</tbody>
	</table>
</panel>
</tabset>
</body>
</rml>
