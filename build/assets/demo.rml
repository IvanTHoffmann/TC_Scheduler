<rml>
<head>
<link type="text/template" href="../../../assets/window.rml"/>
<title>Demo Sample</title>
<link type="text/rcss" href="style.rcss"/>
</head>

<body template="window">

<tabset id="menu">

<tab>Summary</tab>
<panel id="summary">
	<p class="title" align:"center">Summary Page</p>

	<div>
		<select name="filter_name" onkeydown="cancel_selection_on_escape">
				<option value="none" selected>Choose Filter</option>
				<option data-for="filter:filters">{{filter}}</option>
			</select>
		<button class="gradient">Button</button>
	</div>

</panel>

<tab>Manage Schedules</tab>
<panel id="page_manage_schedules">
	<p class="title">Manage Schedules</p>
	<div data-model="app_data">
		<div>
			<select name="tutor_name" onkeydown="cancel_selection_on_escape">
				<option value="none" selected>Choose Tutor</option>
				<option data-for="tutor:tutors" value={{name}}>{{tutor.lastName}}, {{tutor.firstName}}</option>
			</select>
			<button class="gradient">Boot This Toot</button>
		</div>
	</div>
</panel>

<tab>Manage Classes</tab>
<panel id="page_manage_classes">
	<p class="title">Manage Classes</p>
	<div data-model="app_data">
		<div>
			<select name="tutor_name" onkeydown="cancel_selection_on_escape">
				<option value="none" selected>Choose Tutor</option>
				<option data-for="tutor:tutors" value={{name}}>{{tutor.lastName}}, {{tutor.firstName}}</option>
			</select>
			<button class="gradient">Boot This Toot</button>
		</div>
		<div>
			<select name="category_name" onkeydown="cancel_selection_on_escape">
				<option value="none" selected>Choose Category</option>
				<option data-for="category:categories">{{category}}</option>
			</select>
			<input/>
			<button class="gradient">Add</button>
			<button class="gradient">Remove</button>
		</div>
	</div>
	<table>
		<thead>
			<tr>
				<td>Category</td>
				<td>Classes</td>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>Math</td>
				<td>69</td>
			</tr>
			<tr>
				<td>BIO</td>
				<td>999, 123</td>
			</tr>
			<tr>
				<td>COOL</td>
				<td>All Except 420, 101, 102</td>
			</tr>
			<tr>
				<td>NURS</td>
				<td>All</td>
			</tr>
		</tbody>
	</table>
</panel>

<tab>Configure</tab>
<panel>
	<div>
		This is the configuration page where you will be able to control the settings of the application.
	</div>
</panel>

<tab>Test</tab>
<panel>
	<div data-model="app_data">
		<div>
			<select name="tutor_name" onkeydown="cancel_selection_on_escape">
				<option value="none" selected>Choose Tutor</option>
				<option data-for="tutor:tutors" value={{name}}>{{tutor.lastName}}, {{tutor.firstName}}</option>
			</select>
		</div>
	</div>
</panel>
</tabset>
</body>
</rml>
