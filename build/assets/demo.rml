<rml>
<head>
<link type="text/template" href="window.rml"/>
<link type="text/template" href="tutor_select.rml"/>
<link type="text/template" href="department_select.rml"/>
<link type="text/template" href="service_select.rml"/>
<link type="text/template" href="timetable.rml"/>
<title>Tutoring Center Scheduler</title>
<link type="text/rcss" href="style.rcss"/>
</head>

<body template="window">

<tabset data-model="app_data">

<tab data-event-click="OnClick_SummaryTab()">Summary</tab>
<panel>
	<p class="title" align:"center">Summary Page</p>
	
	<div>
		<button class="gradient" data-event-click="OnTutorChanged">Apply Filter</button>
		<template src="timetable"/>

		<br/>

		<div class="flex">
		<div>
			<table class="filter_table">
				<thead>
					<tr>
						<td colspan="2">SERVICES</td>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td class="filter_checkbox">
							<input type="checkbox"
									data-value="filter_all_services" 
									data-event-change="ToggleAllServices()"/>
						</td>
						<td>ALL</td>
					</tr>
					<tr data-for="service:services">
						<td class="filter_checkbox">
							<input type="checkbox" data-value="service.selected"/>
						</td>
						<td>{{service.name}}</td>
					</tr>
				</tbody>
			</table>
		</div>
		<div>
			<table class="filter_table">
				<thead>
					<tr>
						<td colspan="2">DEPARTMENTS</td>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td class="filter_checkbox">
							<input type="checkbox" 
									data-value="filter_all_departments" 
									data-event-change="ToggleAllDepartments()"/>
						</td>
						<td>ALL</td>
					</tr>
					<tr data-for="dept:departments">
						<td class="filter_checkbox"><input type="checkbox" data-value="dept.selected"/></td>
						<td>{{dept.name}}</td>
					</tr>
				</tbody>
			</table>
		</div>
		<div>
			<table class="filter_table">
				<thead>
					<tr>
						<td colspan="2">TUTORS</td>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td class="filter_checkbox">
							<input type="checkbox" 
									data-value="filter_all_tutors" 
									data-event-change="ToggleAllTutors()"/>
						</td>
						<td>ALL</td>
					</tr>
					<tr data-for="tutor:tutors">
						<td class="filter_checkbox"><input type="checkbox" data-value="tutor.selected"/></td>
						<td>{{tutor.last_name}}, {{tutor.first_name}}</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	</div>

</panel>

<tab data-event-click="OnClick_SchedulesTab()">Manage Schedules</tab>
<panel>
	<p class="title">Manage Schedules</p>
	<div>
		<template src="tutor_select"/>
		<template src="service_select"/>
		<div class="schedule-toolbar">
			<button class="gradient" data-event-click="ResetSchedule">Reset Grid</button>
			<div class="schedule-summary">Total: {{total_hours}} hr</div>
		</div>

		<div data-for="selected_tutor.accessor">
			<template src="timetable" />
		</div>

		<div data-for="tutor:selected_tutor.accessor">
			<div>
				<span>Min hours: {{tutor.min_hours}}</span>
				<input type="range" data-value="tutor.min_hours" min=0 max=60 step=1 data-event-change="ScheduleLimitsChanged" data-event-input="ScheduleLimitsChanged"/>
			</div>
			<div>
				<span>Max hours: {{tutor.max_hours}}</span>
				<input type="range" data-value="tutor.max_hours" min=0 max=60 step=1 data-event-change="ScheduleLimitsChanged" data-event-input="ScheduleLimitsChanged"/>
			</div>
		</div>
	</div>
</panel>

<tab data-event-click="OnClick_ClassesTab()">Manage Classes</tab>
<panel>
	<div data-if="!edit_tutor">
		<p class="title">Manage Classes</p>
		<div>

			<span>
				<template src="tutor_select"/>
				<button data-for="selected_tutor.accessor" class="gradient" data-event-click="EnableEditTutor">Edit</button>
			</span>
			<table data-for="tutor:selected_tutor.accessor">
				<thead>
					<tr>
						<td>Department</td>
						<td>Courses</td>
					</tr>
				</thead>
				<tbody>
					<tr data-for="classList:tutor.classes">
						<td>{{classList.department_name}}</td>
						<td>
							<span data-if="classList.subtractive">All{{classList.courses.size ? ' Except ' : ''}}</span>
							<span data-for="course:classList.courses">{{it_index ? ', ' : ''}}{{course}}</span>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<div data-if="edit_tutor" data-for="tutor:selected_tutor.accessor">
		<p class="title">Edit Tutor Info</p>

		<div>
			<span>First Name:</span>
			<input type="text" data-value="tutor.first_name"/>
			<span>   Last Name:</span>
			<input type="text" data-value="tutor.last_name"/>
			<button class="gradient" data-event-click="ConfirmEditTutor">Confirm</button>
		</div>

		<table>
			<thead>
				<tr>
					<td style="width:10%">Department</td>
					<td style="width:10%">All / All Except</td>
					<td>Courses</td>
					<td>Output</td>
				</tr>
			</thead>
			<tbody>
				<tr data-for="department:departments">
					<td>{{department.name}}</td>
					<td>
						<input type="checkbox" data-checked="department.edit_subtractive"/>
					</td>
					<td>
						<input data-value="department.edit_formatted_courses"></input>
					</td>
					<td>
						<span data-if="department.edit_subtractive">All{{department.edit_courses.size ? ' Except ' : ''}}</span>
						<span data-for="course:department.edit_courses">{{it_index ? ', ' : ''}}{{course}}</span>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</panel>

<tab data-event-click="">Preferences</tab>
<panel>
	<div>
		This is the configuration page where you will be able to control the settings of the application.
	</div>
	<div>Export Directory:<input type="text" data-value="export_directory"/></div>
	<div>Developer Options:<input type="checkbox" data-value="dev_enable"/></div>
</panel>

<tab data-event-click="">Export</tab>
<panel>
	<div>
		<button class="gradient" data-event-click="ExportTimetable">Export Timetable</button>
		<button class="gradient" data-event-click="ExportRolodex">Export Rolodex</button>
	</div>
	<div>
		<template src="tutor_select"/><button data-for="tutor:selected_tutor.accessor" class="gradient" data-event-click="CopyTutorHtml">Copy Tutor Html</button>
	</div>
	<div>
		<template src="department_select"/><button data-for="department:selected_department.accessor" class="gradient" data-event-click="CopySubjectHtml">Copy Subject Html</button>
	</div>
	<hr/>
	<div>
		<button class="gradient" data-event-click="ExportAll">Export All</button>
	</div>

</panel>

<tab data-if="dev_enable" data-event-click="">Tests</tab>
<panel>
	
</panel>

</tabset>
</body>
</rml>
