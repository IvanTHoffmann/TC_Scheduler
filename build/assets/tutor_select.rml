<template name="tutor_select">
<head>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="window.rcss"/>
</head>
<body class="tutor_select">
    <select data-model="app_data"
            name="tutor_name"
            data-value="selected_tutor.index"
            data-event-change="OnTutorChanged()"
            onkeydown="cancel_selection_on_escape">
        <option value="-1" >Choose Tutor</option>
        <option data-for="tutor:tutors" data-value="it_index">{{tutor.first_name}}, {{tutor.last_name}}</option>
    </select>
</body>
</template>
