<template name="tutor_select">
<head>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="window.rcss"/>
</head>
<body class="tutor_select">
    <select data-model="app_data" name="tutor_name" data-value="selected_tutor" onkeydown="cancel_selection_on_escape">
        <option selected value=-1 data-event-click="SetTutor(-1)">Choose Tutor</option>
        <option data-for="tutor:tutors" data-value="it_index" data-event-click="SetTutor(it_index)">{{tutor.last_name}}, {{tutor.first_name}}</option>
    </select>
</body>
</template>
