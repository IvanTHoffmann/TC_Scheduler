<template name="timetable">
<head>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="window.rcss"/>
</head>
<body class="timetable" data-model="app_data">
	<div>
		<table background-color="#000" style="row-gap: 2px; column-gap: 2px"
				data-event-mouseup="OnTimetableMouseUp()"
				data-event-mouseout="OnTimetableMouseOut()">
			<tr>
				<td></td>
				<td colspan=2 data-for="label:timetable.view[0].accessor">{{label}}</td>
				<td></td>
			</tr>
			<tr data-for="row,row_id:timetable.rows" data-event-mouseout="">
				<td colspan=2>{{row.label}}</td>
				<td data-for="slot,slot_id:row.view[0].accessor" class="slot"
					data-style-background-color="GetSlotColor(slot.value)"
					data-event-mousedown="OnSlotMouseDown(row_id, slot_id)"
					data-event-mouseover="OnSlotMouseOver(row_id, slot_id)">
				</td>
			</tr>
			<tr>
				<td></td>
				<td colspan=2 data-for="label:timetable.view[0].accessor">{{label}}</td>
				<td></td>
			</tr>
		</table>
	</div>
</body>
</template>